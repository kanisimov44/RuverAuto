# Скопируйте в .env и поменяйте пароль и секретный ключ:
#   cp .env.example .env

# DEV | TEST | PROD
MODE=DEV
LOG_LEVEL=INFO

# Название компании: заголовок вкладки, копирайт, админка, документация API
SITE_NAME=Моя компания
# Домен сайта для nginx в продакшен-режиме (docker-compose.prod.yml)
DOMAIN=example.com
# Фирменный цвет сайта в формате #rrggbb
ACCENT_COLOR=#2563eb

# Общие для приложения и контейнера postgres.
# В docker compose POSTGRES_HOST переопределяется на имя сервиса (db).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ruverauto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ruverauto

# В docker compose REDIS_HOST переопределяется на имя сервиса (redis).
REDIS_HOST=localhost
REDIS_PORT=6379

# Ключ для подписи JWT и cookie сессии админки.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
